{
  "PreToolUse": [
    {
      "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/commit-authorship-gate",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/worktree-location-gate",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/process-kill-gate",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Agent|Task|mcp__ccd_session__start_session|advisor",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/agent-model-gate",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash|Monitor|mcp__.*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/mail-send-gate",
          "timeout": 10
        }
      ]
    }
  ],
  "WorktreeCreate": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/scripts/worktree-location hook-create",
          "timeout": 600
        }
      ]
    }
  ],
  "WorktreeRemove": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/scripts/worktree-location hook-remove",
          "timeout": 120
        }
      ]
    }
  ]
}
