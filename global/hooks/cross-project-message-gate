#!/usr/bin/env python3
"""PreToolUse(SendMessage): a session only writes to sessions of its own project.

Rule: ~/.claude/rules/mensajes-entre-sesiones-solo-mismo-proyecto.md.

The recipient is resolved against the CLI registry (`~/.claude/sessions/*.json`) and, when it has no process, against
the desktop app's session records. Two roots are the same project when they share the git common dir (worktrees count
as their main checkout) or when one is a workspace (a non-git folder that groups projects, never $HOME) and the other
lies inside it. Subagents and teammates of the sender are not in the registry and pass untouched.

Same project: silent. Other project, or a recipient whose project cannot be known: the developer decides. Under
bypassPermissions an «ask» is swallowed, so there the call is denied and the agent opens AskUserQuestion; the retry to
that recipient passes only if the developer answered a dialog opened after the denial (a dialog that a hook denied or
that was dismissed is no yes). That yes stays valid for APPROVAL_WINDOW seconds, because one send can fire this hook
twice (SendMessage is delivered through a second tool call).

Exceptions are OFF unless `message_exceptions` in the `supervision` config piece names them. An exception never
rests on the text of the message alone:
  account_switch     the account-switch marker, from the session holding the current claim of the switch event, to a
                     session that event lists, once per event.
  project_resume     the resume marker, to a session that `project-pause resume` listed, as that script decides.
  skill_reload       the reload marker, from a session started in one of `config_session_dirs`, to a supervisor (the
                     owner of a lock) that has not read the latest change of a skill, a rule or supervisor-lock.
  supervisor_revive  the revive marker, from one of `config_session_dirs`, to a supervisor that `supervisor-lock
                     revive --plan` named in the last `supervisor_revive_valid_s` seconds.
A marker whose exception is off is plain text. A missing, corrupt or wrongly typed config means the defaults below:
no exception at all.

Paths for tests: CROSS_PROJECT_GATE_{STATE,REGISTRY,APP_SESSIONS,CONFIG_DIRS,LOCKS,REVIVE,UPDATED_GLOBS},
ACCOUNT_SWITCH_STATE, ACCOUNT_SWITCH_PROJECTS, PROJECT_PAUSE_BIN.
"""
import calendar, glob, json, os, re, subprocess, sys, time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'scripts', 'lib'))
try:
    from toolkit_config import load_checked as _load_config
except ImportError:  # no helper, or one older than load_checked: the code's defaults, which allow no exception
    def _load_config(piece, defaults):
        return dict(defaults)
CONFIG = _load_config("supervision", {
    "account_switch_marker": "[cambio de cuenta]",
    "project_resume_marker": "[reanudar proyecto]",
    "skill_reload_marker": "[recarga de skill]",
    "supervisor_revive_marker": "[reanimar supervisora]",
    "account_switch_ttl_s": 21600,
    "account_switch_claim_window_s": 1800,
    "supervisor_revive_valid_s": 1800,
    "presence_min": 20,
    "app_sessions_dir": "~/.config/Claude/claude-code-sessions",
    "message_exceptions": [],
    "config_session_dirs": [],
})

REGISTRY = os.environ.get("CROSS_PROJECT_GATE_REGISTRY") or os.path.expanduser("~/.claude/sessions")
APP_SESSIONS = os.environ.get("CROSS_PROJECT_GATE_APP_SESSIONS") or \
    os.path.expanduser(CONFIG["app_sessions_dir"])
STATE_DIR = os.environ.get("CROSS_PROJECT_GATE_STATE") or \
    os.path.expanduser("~/.claude/state/cross-project-message-gate")
CCD_TOOL = "mcp__ccd_session_mgmt__send_message"
TOOLS = ("SendMessage", CCD_TOOL)
REF = re.compile(r"\s*\[[0-9a-f]{4,12}\]\s*$")
LOCAL_ID = re.compile(r"^local_[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$")
UUID = re.compile(r"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$")
APPROVAL_WINDOW = 30  # seconds an approved recipient stays open after the dialog
SWITCH_EVENT = os.path.join(
    os.environ.get("ACCOUNT_SWITCH_STATE") or os.path.expanduser("~/.claude/state/account-switch"), "event.json")
SWITCH_MARKER = CONFIG["account_switch_marker"]
SWITCH_TTL = CONFIG["account_switch_ttl_s"]
SWITCH_PROJECTS = os.environ.get("ACCOUNT_SWITCH_PROJECTS") or os.path.expanduser("~/.claude/projects")
SWITCH_CLAIM_WINDOW = CONFIG["account_switch_claim_window_s"]


def enabled(exception: str) -> bool:
    return exception in CONFIG["message_exceptions"]


def _iso_epoch(ts: str):
    """Epoch seconds of a transcript timestamp like 2020-01-01T10:00:00.000Z, or None."""
    try:
        return calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) + float("0" + ts[19:].rstrip("Z"))
    except (ValueError, TypeError):
        return None


def _delivered_text(entry: dict) -> str:
    """The text of a resume as it lands in a recipient's transcript, in the three shapes Claude Code writes, or ""."""
    if entry.get("type") == "user" and entry.get("isMeta"):  # idle recipient: the peer message itself
        origin = entry.get("origin") or {}
        return origin.get("body") or "" if origin.get("kind") == "peer" else ""
    if entry.get("type") == "queue-operation" and entry.get("operation") == "enqueue":  # busy: queued
        return entry.get("content") or ""
    attachment = entry.get("attachment") or {}
    return attachment.get("prompt") or "" if attachment.get("type") == "queued_command" else ""


def delivered_at(cli_session_id: str, since: float):
    """Epoch of the first resume that reached this session's transcript at or after `since`, or None. A tool result or
    an answer that merely quotes the marker is not a delivery."""
    for path in glob.glob(os.path.join(SWITCH_PROJECTS, "*", f"{cli_session_id}.jsonl")):
        try:
            with open(path, errors="replace") as fh:
                for line in fh:
                    if SWITCH_MARKER not in line:
                        continue
                    try:
                        entry = json.loads(line)
                    except ValueError:
                        continue
                    at = _iso_epoch(entry.get("timestamp") or "")
                    text = _delivered_text(entry)
                    if at is not None and at >= since and isinstance(text, str) and SWITCH_MARKER in text:
                        return at
        except OSError:
            continue
    return None


PROJECT_RESUME_MARKER = CONFIG["project_resume_marker"]


def project_resume(to: str, inp: dict):
    """Verdict on a «[reanudar proyecto]» message: None (no marker), ("allow", project) or ("deny", reason).

    The session that ran `project-pause resume` may wake the sessions that command listed, once each and for a
    limited time, without the cross-project dialog."""
    text = str(inp.get("message") or inp.get("content") or "")
    if PROJECT_RESUME_MARKER not in text:
        return None
    try:
        import importlib.machinery, importlib.util
        path = os.path.expanduser(os.environ.get("PROJECT_PAUSE_BIN", "~/.claude/scripts/project-pause"))
        loader = importlib.machinery.SourceFileLoader("project_pause_for_gate", path)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        ok, why = module.resume_allowed(to)
    except Exception as err:
        return "deny", f"no se pudo comprobar la reanudación ({type(err).__name__})"
    return ("allow", why) if ok else ("deny", why)


RELOAD_MARKER = CONFIG["skill_reload_marker"]


def _env_list(name: str, default: list) -> list:
    value = os.environ.get(name)
    return [p for p in value.split(os.pathsep) if p] if value else default


def _config_dirs() -> list:
    """`config_session_dirs` as written (the test override first): the one list the check and its message both use."""
    return _env_list("CROSS_PROJECT_GATE_CONFIG_DIRS", CONFIG["config_session_dirs"])


def _not_a_config_sender() -> str:
    """Why a sender outside those folders cannot send the marker, naming the folders instead of the config key."""
    dirs = _config_dirs()
    lead = "solo la manda una sesión de la configuración global"
    if not dirs:
        return (f"{lead}, y no hay ninguna carpeta declarada para eso: la lista config_session_dirs de la "
                "configuración de supervisión está vacía")
    where = f"«{dirs[0]}»" if len(dirs) == 1 else "alguna de estas carpetas: " + ", ".join(f"«{d}»" for d in dirs)
    return f"{lead}, es decir, una que empezó o trabaja dentro de {where}"


def _config_sender(cwd: str, sid: str) -> bool:
    """The sender maintains the global configuration: its current folder or the one it started in (the app's
    `originCwd`) is one of `config_session_dirs`."""
    folders = [cwd or os.getcwd()]
    if sid and sid != "unknown":
        for rec in app_sessions(sid, lambda r: r.get("cliSessionId") == sid):
            folders += [rec.get("originCwd") or "", rec.get("cwd") or ""]
    config = [os.path.realpath(os.path.expanduser(p)) for p in _config_dirs()]
    return any(real == d or real.startswith(d.rstrip("/") + "/")
               for real in (os.path.realpath(f) for f in folders if f) for d in config)


def _supervisor_lock(to: str):
    """(lock key, lock) of the supervisor `to` names (its local_… id or its CLI session id), or (None, None)."""
    locks_dir = os.environ.get("CROSS_PROJECT_GATE_LOCKS") or os.path.expanduser("~/.claude/supervisor/locks")
    for path in sorted(glob.glob(os.path.join(locks_dir, "*.json"))):
        try:
            with open(path) as fh:
                lock = json.load(fh)
        except (OSError, ValueError):
            continue
        owner = lock.get("session_id") if isinstance(lock, dict) else None
        if not owner:
            continue
        match = to == owner
        for rec_path in ([] if match else glob.glob(os.path.join(APP_SESSIONS, "*", "*", glob.escape(owner) + ".json"))):
            try:
                with open(rec_path) as fh:
                    match = json.load(fh).get("cliSessionId") == to
            except (OSError, ValueError, AttributeError):
                continue
            if match:
                break
        if match:
            return os.path.basename(path)[:-5], lock
    return None, None


def skill_reload(to: str, inp: dict, cwd: str, sid: str = ""):
    """Verdict on a «[recarga de skill]» message: None (no marker), ("allow", project) or ("ignore", reason).

    The sender is judged by the folder it is in now or the one it started in (the app's `originCwd`), because the
    current folder of a configuration session follows it when it works elsewhere."""
    text = str(inp.get("message") or inp.get("content") or "")
    if RELOAD_MARKER not in text:
        return None
    if not _config_sender(cwd, sid):
        return "ignore", _not_a_config_sender()
    key, lock = _supervisor_lock(to)
    project = (lock.get("project") or key) if lock else None
    seen = lock.get("skill_seen") if lock and isinstance(lock.get("skill_seen"), (int, float)) else None
    if not project:
        return "ignore", f"«{to}» no es una supervisora (no tiene cerrojo de supervisión; nómbrala por su id local_…)"
    newest = 0.0
    for pattern in _env_list("CROSS_PROJECT_GATE_UPDATED_GLOBS", [
            "~/.claude/skills/*/SKILL.md", "~/.claude/skills/*/reference/*.md", "~/.claude/rules/*.md",
            "~/.claude/scripts/supervisor-lock"]):
        for path in glob.glob(os.path.expanduser(pattern)):
            try:
                newest = max(newest, os.stat(path).st_mtime)
            except OSError:
                pass
    # `skill_seen` is the mtime of the skill version the supervisor read (supervisor-lock beat --skill-seen); without it
    # the supervisor never read it. An update is anything newer than that version.
    if seen is not None and newest <= seen + 1e-6:
        return "ignore", ("ya recargó la skill después del último cambio de una skill, una regla global o "
                          "supervisor-lock")
    return "allow", project


REVIVE_MARKER = CONFIG["supervisor_revive_marker"]
REVIVE_VALID_S = CONFIG["supervisor_revive_valid_s"]


def supervisor_revive(to: str, inp: dict, cwd: str, sid: str = ""):
    """Verdict on a «[reanimar supervisora]» message: None (no marker), ("allow", project) or ("ignore", reason).

    A scheduled task of the global configuration wakes a supervisor whose process died. It passes only for a
    target that `supervisor-lock revive --plan` named in the last REVIVE_VALID_S, so the plan decides, never the
    text."""
    text = str(inp.get("message") or inp.get("content") or "")
    if REVIVE_MARKER not in text:
        return None
    if not _config_sender(cwd, sid):
        return "ignore", "solo la manda la tarea «Reanimar supervisoras» (configuración global)"
    key, lock = _supervisor_lock(to)
    if not lock:
        return "ignore", f"«{to}» no es una supervisora (no tiene cerrojo de supervisión; nómbrala por su id local_…)"
    path = os.environ.get("CROSS_PROJECT_GATE_REVIVE") or os.path.expanduser("~/.claude/supervisor/revive.json")
    try:
        with open(path) as fh:
            entry = (json.load(fh) or {}).get(key) or {}
    except (OSError, ValueError, AttributeError):
        entry = {}
    planned = entry.get("planned_at") if isinstance(entry.get("planned_at"), (int, float)) else 0
    if entry.get("session") != lock.get("session_id") or not 0 <= time.time() - planned <= REVIVE_VALID_S:
        return "ignore", "`supervisor-lock revive` no la ha señalado como muerta en la última media hora"
    return "allow", lock.get("project") or key


def account_switch_resume(to: str, inp: dict, sid: str):
    """Verdict on a «[cambio de cuenta]» message: None (no marker), ("allow", ""), ("duplicate", HH:MM it got it)
    or ("stale", reason).

    Allowed only from the session holding the current, fresh claim, to a session the switch left stopped."""
    text = str(inp.get("message") or inp.get("content") or "")
    if SWITCH_MARKER not in text:
        return None
    try:
        with open(SWITCH_EVENT) as fh:
            event = json.load(fh)
    except (OSError, ValueError):
        return "stale", "no hay ningún cambio de cuenta pendiente"
    if not isinstance(event, dict):
        return "stale", "no hay ningún cambio de cuenta pendiente"
    now = time.time()
    if event.get("done"):
        return "stale", "el cambio de cuenta ya terminó"
    # Age counts from `not_before` when the new account had no usage at the switch.
    at = event.get("at") or 0
    if not at <= now or now - max(at, event.get("not_before") or 0) >= SWITCH_TTL:
        return "stale", "el cambio de cuenta ya terminó o es demasiado antiguo"
    if not event.get("claimed_by"): 
        return "stale", ("nadie lo ha reclamado todavía (lo reclama la tarea de la app o la primera sesión que "
                         "arranque con la cuenta con uso)")
    if event.get("claimed_by") not in (sid, "scheduled-task:" + sid):
        return "stale", "lo reclamó otra sesión"
    claimed_at = event.get("claimed_at") or 0
    if not 0 <= now - claimed_at < SWITCH_CLAIM_WINDOW:
        return "stale", "tu reclamación caducó a las " + time.strftime("%H:%M", time.localtime(claimed_at + SWITCH_CLAIM_WINDOW))
    listed = next((s for s in event.get("sessions") or [] if to in (s.get("sessionId"), s.get("cliSessionId"))), None)
    if not listed:
        return "stale", f"«{to}» ya no está en la lista"
    got = delivered_at(listed.get("cliSessionId") or to, event.get("at") or 0)
    if got is not None:
        return "duplicate", time.strftime("%H:%M", time.localtime(got))
    return "allow", ""


def project_root(cwd: str) -> str:
    if not cwd:
        return ""
    try:
        out = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=3,
        )
        if out.returncode == 0 and out.stdout.strip():
            common = out.stdout.strip()
            return os.path.dirname(common) if os.path.basename(common) == ".git" else common
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.realpath(cwd)


def is_workspace(root: str) -> bool:
    """A non-git folder that groups projects. Never `$HOME` or one of its ancestors."""
    if not root or not os.path.isdir(root) or os.path.exists(os.path.join(root, ".git")):
        return False
    home = os.path.realpath(os.path.expanduser("~"))
    if home == root or home.startswith(root.rstrip("/") + "/"):
        return False
    if os.path.exists(os.path.join(root, "CLAUDE.md")) or os.path.isdir(os.path.join(root, "openspec")):
        return True
    try:
        return any(os.path.exists(os.path.join(root, d, ".git")) for d in os.listdir(root))
    except OSError:
        return False


def same_project(a: str, b: str) -> bool:
    """Equal roots, or one is a workspace and the other lies inside it."""
    if not a or not b:
        return False
    if a == b:
        return True
    return (b.startswith(a.rstrip("/") + "/") and is_workspace(a)) or \
        (a.startswith(b.rstrip("/") + "/") and is_workspace(b))


def registry() -> list:
    rows = []
    for path in glob.glob(os.path.join(REGISTRY, "*.json")):
        try:
            with open(path) as fh:
                row = json.load(fh)
        except (OSError, ValueError):
            continue
        row["_alive"] = os.path.exists(f"/proc/{row.get('pid')}")
        rows.append(row)
    return rows


def app_sessions(needle: str, test, filename: str = "local_*.json") -> list:
    """Session records the desktop app keeps that pass `test`.

    The app writes one JSON per session, also while the session has no process, and a
    copy under every account directory (13 MB each). Only the most recently written
    directory with a match is read. `needle` is a cheap substring filter before parsing."""
    dirs = [d for d in glob.glob(os.path.join(APP_SESSIONS, "*", "*")) if os.path.isdir(d)]
    for d in sorted(dirs, key=os.path.getmtime, reverse=True):
        found = []
        for path in glob.glob(os.path.join(d, filename)):
            try:
                with open(path, errors="ignore") as fh:
                    text = fh.read()
            except OSError:
                continue
            if needle not in text:
                continue
            try:
                rec = json.loads(text)
            except ValueError:
                continue
            if rec.get("sessionId") and test(rec):
                found.append(rec)
        if found:
            return found
    return []


def app_root(rec: dict) -> str:
    for cwd in (rec.get("cwd"), rec.get("originCwd")):
        if cwd and os.path.isdir(cwd):
            return project_root(cwd)
    for anchor in rec.get("gitAnchors") or []:
        common = anchor.get("commonDir") or ""
        if common:
            return os.path.dirname(common) if os.path.basename(common) == ".git" else common
    cwd = rec.get("cwd") or rec.get("originCwd") or ""
    if "/.claude/worktrees/" in cwd:  # removed worktree: the repo that held it
        return project_root(cwd.split("/.claude/worktrees/")[0])
    return os.path.realpath(cwd) if cwd else ""


def app_lookup(name: str, tool: str, own_sid: str):
    """(records, must_be_session) for a recipient with no row in the registry."""
    if LOCAL_ID.match(name):
        return app_sessions(name, lambda r: r.get("sessionId") == name, f"{name}.json"), True
    if UUID.match(name):
        return app_sessions(name, lambda r: r.get("cliSessionId") == name), True
    if tool != CCD_TOOL:
        return [], False  # SendMessage by name: own subagents and teammates live here
    me = app_sessions(own_sid, lambda r: r.get("cliSessionId") == own_sid) if own_sid else []
    me = me[0] if me else {}
    parent = (me.get("spawnedFrom") or {}).get("sessionId") or ""
    if name == "parent":
        if not parent:
            return [], True
        return app_sessions(parent, lambda r: r.get("sessionId") == parent, f"{parent}.json"), True
    # A short name resolves inside the linked family: my children and my siblings.
    recs = app_sessions(name, lambda r: (r.get("spawnedFrom") or {}).get("name") == name
                        and not r.get("isArchived"))
    family = {me.get("sessionId"), parent} - {None, ""}
    in_family = [r for r in recs if (r.get("spawnedFrom") or {}).get("sessionId") in family]
    return in_family or recs, True


def recipient(tool: str, inp: dict) -> str:
    if tool == "SendMessage":
        return str(inp.get("to") or inp.get("recipient") or "").strip()
    for key in ("session_id", "sessionId", "to", "id"):
        if inp.get(key):
            return str(inp[key]).strip()
    return ""


def resolve(to: str, rows: list, tool: str = "", own_sid: str = ""):
    """Return (set of project roots, label) for the recipient, or (None, why) if unknown."""
    m = re.match(r"^uds:.*/(\d+)\.sock$", to)
    if m:
        pid = m.group(1)
        row = next((r for r in rows if str(r.get("pid")) == pid), None)
        cwd = (row or {}).get("cwd")
        if not cwd:
            try:
                cwd = os.readlink(f"/proc/{pid}/cwd")
            except OSError:
                return None, f"pid {pid} sin registro"
        return {project_root(cwd)}, (row or {}).get("name") or f"pid {pid}"
    by_id = [r for r in rows if to in (r.get("sessionId"), r.get("hostSessionId"))]
    name = REF.sub("", to)
    by_name = by_id or [r for r in rows if r.get("name") == name]
    alive = [r for r in by_name if r["_alive"]] or by_name
    if alive:
        return {project_root(r.get("cwd", "")) for r in alive}, name
    recs, must_be_session = app_lookup(name, tool, own_sid)
    if recs:
        roots = {app_root(r) for r in recs}
        titles = sorted({r.get("title") or "" for r in recs} - {""})
        label = f"{name} ({', '.join(titles)})" if titles and name not in titles else name
        if "" in roots:
            return None, f"{label}, sin carpeta registrada"
        return roots, label
    if must_be_session:
        return None, "sin proceso vivo ni registro de la app"
    return set(), name  # not a local peer: subagent, teammate or remote


def _texts(node):
    if isinstance(node, str):
        yield node
    elif isinstance(node, list):
        for x in node:
            yield from _texts(x)
    elif isinstance(node, dict):
        for x in node.values():
            yield from _texts(x)


def remote_peer(to: str, transcript: str) -> bool:
    """A cloud / Remote Control row from ListAgents: a peer whose directory we cannot see."""
    if not transcript or not os.path.exists(transcript):
        return False
    needle = to if REF.search(to) else f"{to} ["
    try:
        with open(transcript, errors="ignore") as fh:
            for line in fh:
                if "Peer sessions" not in line:
                    continue
                try:
                    texts = list(_texts(json.loads(line)))
                except ValueError:
                    continue
                for text in texts:
                    for row in text.splitlines():
                        if needle in row and ("Remote Control" in row or "cloud" in row):
                            return True
    except OSError:
        return False
    return False


def _epoch(ts) -> float | None:
    try:
        return calendar.timegm(time.strptime(str(ts or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


def asked_since(transcript: str, since: float) -> bool:
    """True when an AskUserQuestion opened at or after `since` got an answer from the developer.

    The call needs a tool_result that is not an error: that is a dialog the developer saw and answered. A dialog
    that a hook denied or that was dismissed leaves an error result, so it is no yes.
    """
    if not transcript or not os.path.exists(transcript):
        return False
    asks, answered = set(), set()
    try:
        with open(transcript, errors="ignore") as fh:
            for line in fh:
                if "AskUserQuestion" not in line and "tool_result" not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                msg = d.get("message") if isinstance(d, dict) else None
                content = msg.get("content") if isinstance(msg, dict) else None
                if not isinstance(content, list):
                    continue
                t = _epoch(d.get("timestamp"))
                for item in content:
                    if not isinstance(item, dict):
                        continue
                    if item.get("type") == "tool_use" and item.get("name") == "AskUserQuestion":
                        if t is not None and t >= since - 1 and item.get("id"):
                            asks.add(item["id"])
                    elif item.get("type") == "tool_result" and not item.get("is_error"):
                        if item.get("tool_use_id"):
                            answered.add(item["tool_use_id"])
    except OSError:
        return False
    return bool(asks & answered)


def load_state(sid: str) -> dict:
    try:
        with open(os.path.join(STATE_DIR, f"{sid}.json")) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_state(sid: str, state: dict) -> None:
    now = time.time()
    approved = {k: v for k, v in (state.get("approved") or {}).items()
                if isinstance(v, (int, float)) and 0 <= now - v < APPROVAL_WINDOW}
    if approved:
        state["approved"] = approved
    else:
        state.pop("approved", None)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, f"{sid}.json"), "w") as fh:
            json.dump(state, fh)
    except OSError:
        pass


def log(sid: str, action: str, to: str, why: str) -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, "decisions.log"), "a") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}\t{sid[:8]}\t{action}\t{to[:60]}\t{why[:120]}\n")
    except OSError:
        pass


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0
    if not isinstance(payload, dict):
        return 0
    tool = payload.get("tool_name") or ""
    if tool not in TOOLS:
        return 0
    to = recipient(tool, payload.get("tool_input") or {})
    if not to:
        return 0
    sid = payload.get("session_id") or "unknown"
    transcript = payload.get("transcript_path") or ""
    mine = project_root(payload.get("cwd") or os.getcwd())

    resume = project_resume(to, payload.get("tool_input") or {}) if enabled("project_resume") else None
    if resume and resume[0] == "allow":
        log(sid, "allow-project-resume", to, "reanudación del proyecto " + resume[1])
        return 0
    if resume:
        log(sid, "deny-project-resume", to, resume[1])
        json.dump({
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": (
                    f"cross-project-message-gate: aviso de reanudación rechazado: {resume[1]}. Solo se envía a las "
                    "sesiones que lista `~/.claude/scripts/project-pause resume`, una vez y en los 30 minutos "
                    "siguientes. No preguntes al desarrollador por ello."
                ),
            },
            "systemMessage": f"cross-project-message-gate: aviso de reanudación rechazado ({to[:60]})",
        }, sys.stdout)
        return 0

    reload = skill_reload(to, payload.get("tool_input") or {}, payload.get("cwd") or "", sid) \
        if enabled("skill_reload") else None
    if reload and reload[0] == "allow":
        log(sid, "allow-skill-reload", to, "orden de recargar la skill a la supervisora de " + reload[1])
        return 0

    revive = supervisor_revive(to, payload.get("tool_input") or {}, payload.get("cwd") or "", sid) \
        if enabled("supervisor_revive") else None
    if revive and revive[0] == "allow":
        log(sid, "allow-supervisor-revive", to, "reanimar a la supervisora de " + revive[1])
        return 0

    # Before the same-project shortcut: a stale resume to a sibling of the same project is just as wrong.
    switch = account_switch_resume(to, payload.get("tool_input") or {}, sid) if enabled("account_switch") else None
    if switch and switch[0] == "allow":
        log(sid, "allow-account-switch", to, "reanudación tras un cambio de cuenta")
        return 0
    if switch and switch[0] == "duplicate":
        log(sid, "deny-duplicate-account-switch", to, "ya recibió el aviso a las " + switch[1])
        json.dump({
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": (
                    f"cross-project-message-gate: Esta sesión ya recibió el aviso de cambio de cuenta a las {switch[1]}. "
                    "No lo repitas ni preguntes al desarrollador; si quedan otras de la lista, envíaselo solo a esas "
                    "(`~/.claude/scripts/account-switch mine` dice cuáles)."
                ),
            },
            "systemMessage": f"cross-project-message-gate: aviso de cambio de cuenta repetido rechazado ({to[:60]})",
        }, sys.stdout)
        return 0
    if switch:
        log(sid, "deny-stale-account-switch", to, switch[1])
        json.dump({
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": (
                    f"cross-project-message-gate: este aviso de cambio de cuenta ya no es tuyo ({switch[1]}). "
                    "Solo lo envía la sesión que tiene la reclamación vigente. No lo envíes ni ejecutes "
                    "account-switch done, no le preguntes al desarrollador por ello y sigue con tu propia tarea."
                ),
            },
            "systemMessage": f"cross-project-message-gate: aviso de cambio de cuenta rechazado ({switch[1]})",
        }, sys.stdout)
        return 0

    roots, label = resolve(to, registry(), tool, sid)
    if roots and all(same_project(r, mine) for r in roots):
        return 0
    if roots == set():
        if not remote_peer(to, transcript):
            return 0  # own subagent or teammate
        why = f"«{label}» es una sesión cloud/Remote Control: su proyecto no se puede saber"
    elif roots is None:
        why = f"no se puede saber a qué proyecto pertenece «{to}» ({label})"
    else:
        others = ", ".join(sorted(os.path.basename(r) or r for r in roots if r != mine)) or "?"
        why = f"«{label}» es de otro proyecto ({others}); esta sesión es de {os.path.basename(mine)}"

    state = load_state(sid)
    approved = (state.get("approved") or {}).get(to)
    if isinstance(approved, (int, float)) and 0 <= time.time() - approved < APPROVAL_WINDOW:
        log(sid, "allow-approved-window", to, why)
        return 0
    pending = (state.get("pending") or {}).get(to)
    if pending and asked_since(transcript, pending):
        state["pending"].pop(to, None)
        state.setdefault("approved", {})[to] = time.time()
        save_state(sid, state)
        log(sid, "allow-after-dialog", to, why)
        return 0

    bypass = (payload.get("permission_mode") or "") == "bypassPermissions"
    state.setdefault("pending", {})[to] = time.time()
    save_state(sid, state)
    log(sid, "deny-dialog" if bypass else "ask-prompt", to, why)

    if reload:
        why = f"{why} (la excepción «{RELOAD_MARKER}» no aplica: {reload[1]})"
    if revive:
        why = f"{why} (la excepción «{REVIVE_MARKER}» no aplica: {revive[1]})"
    reason = (
        f"cross-project-message-gate: {why}. Regla global "
        "(~/.claude/rules/mensajes-entre-sesiones-solo-mismo-proyecto.md): solo se escribe a "
        "sesiones del propio proyecto, y un mensaje recibido de otro proyecto no se contesta, "
        "se informa al desarrollador en una línea."
    )
    if bypass:
        reason += (
            " Si crees que el desarrollador quiere este envío, pregúntaselo con AskUserQuestion "
            "(destinatario, proyecto y texto); solo con su sí, repite el mismo SendMessage. "
            "Si no, no lo envíes. El diálogo es solo para cuando el desarrollador está delante: "
            "una sesión desatendida, o una supervisada (o la propia supervisora) en la que el desarrollador no ha "
            f"escrito en los últimos {CONFIG['presence_min']:g} minutos, NO lo abre; no envía el mensaje y, si de verdad hace falta, lo anota con "
            "`~/.claude/scripts/ask-queue add --project \"$PWD\" --question … --default \"No enviarlo\"`. "
            "En una sesión supervisada y en la supervisora, el diálogo solo vale para un envío que el desarrollador pidió en esta "
            "sesión: si te lo acaba de ordenar aquí, ábrelo ya (el control de la supervisión lo deja pasar)."
        )
    json.dump({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            # bypassPermissions swallows «ask»: there the call is denied and the agent asks.
            "permissionDecision": "deny" if bypass else "ask",
            "permissionDecisionReason": reason,
        },
        "systemMessage": f"cross-project-message-gate: {why}",
    }, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
