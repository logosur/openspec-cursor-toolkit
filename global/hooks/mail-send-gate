#!/usr/bin/env python3
"""PreToolUse(Bash, Monitor, mcp__*): agents never send or change mail; the developer sends.

Why: an agent may search and read mail and may draft text, but a session that holds a mail connector can call its
send, reply, forward, label, trash or spam tools, and any session can send through Bash. A written rule alone is not
followed deterministically; this gate makes it so. It never changes a call, it only denies.

What it denies:
  - Connector tools `mcp__<server>__<tool>` (split at the last `__`) whose <tool> matches `send_tools`, unless the
    server matches `ignore_servers` (default: the desktop app's own `ccd_*` tools) or <tool> matches `read_tools`
    (read patterns always win). With `drafts` true, tools matching `draft_tools` pass. The server segment is never
    compared with a stored connector identifier.
  - Shell commands that send mail (the `command` of Bash, Monitor or a connector's `run_in_terminal`), found at
    command position only (quote-aware split at shell separators, unquoted `$(…)` and backticks, `sh|bash|zsh|dash
    -c` or the commands a shell reads on stdin, `eval`, `su -c`, `find -exec`, assignments and wrappers such as sudo,
    doas, env, xargs, timeout skipped, short-option clusters such as `sudo -iu root` included): `sendmail` (and
    ssmtp, esmtp), `mail`, `mailx` (and its s-nail / mailutils names); `mutt`/`neomutt` with `-s`, `-a`, `-H` or a
    recipient; `msmtp`/`msmtpq`, `swaks`, `git send-email` and `curl smtp(s)://` without a local target (curl with a
    proxy, `--connect-to` or `--resolve` is never local); `curl --mail-rcpt|--mail-from` without an SMTP URL; an
    inline interpreter (python, perl, ruby, node, php; clustered code options such as `-Ic`, `-le` included) whose
    own code uses an SMTP library unless every connection names a plain local host literal; any command matching an
    `extra_commands` regex.
  - Always allowed: the local test mailer, an explicit SMTP host equal to localhost, 127.0.0.1 or ::1, or ending in
    .localhost or .test (whole-host match).

Config piece `mail-send-gate` (a wrong-shaped or missing value keeps the default; a pattern that does not compile is
skipped and logged): exempt_paths [] (folders whose own Bash send flow is authorised; connector tools are never
exempted), extra_commands [], drafts false, send_tools, draft_tools, read_tools, ignore_servers (regexes, case
insensitive). A missing or corrupt config gives these code defaults, which deny.

Known limits: a send inside a script file (`python3 send.py`, `bash send.sh`), a module (`python3 -m x`), a project
runner (`uv run`, `poetry run`, `npx`), a container or a remote host (`ssh`) is not seen (`extra_commands` covers a project's known scripts); detection is textual, so inline code that only
mentions an SMTP library is denied; commands built at run time (`$CMD`, `eval`) are not seen; a non-mail connector
tool named like a mail write (`send_message`) is denied unless its server matches `ignore_servers`.

Never breaks a session: unparseable input, a non-object payload or any exception lets the call through with no output
(the traceback goes to errors.log). decisions.log gets one line per deny and per exempt allow (time, session, tool,
decision, category), never the command text, recipients or message bodies.
State dir: ~/.cache/claude-toolkit/mail-send-gate (override: MAIL_SEND_GATE_STATE).
Rule: ~/.claude/rules/correo-solo-lectura.md.
"""
import json
import os
import re
import shlex
import sys
import time
import traceback
from urllib.parse import urlsplit

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'scripts', 'lib'))
try:
    from toolkit_config import load_checked as _load_config
except ImportError:  # no helper, or one older than load_checked: the code's defaults
    def _load_config(piece, defaults):
        return dict(defaults)

DEFAULTS = {
    'exempt_paths': [],
    'extra_commands': [],
    'drafts': False,
    'send_tools': [
        '^(send_message|send_email|send_mail|send_draft)$',
        '^(reply|reply_all|forward)$',
        '^(create_draft|update_draft|delete_draft)$',
        '^(trash|untrash|delete)_(message|thread)$',
        '^(mark|unmark)_(message|thread)_spam$',
        '^(label|unlabel)_(message|thread)$',
        '^(update_message_labels|apply_sensitive_message_label|apply_sensitive_thread_label)$',
        '^(create|update|delete)_label$',
    ],
    'draft_tools': ['^(create_draft|update_draft)$'],
    'read_tools': ['^(search|get|list|read|download|fetch)_'],
    'ignore_servers': ['^ccd_'],
}
STATE_DIR = os.environ.get('MAIL_SEND_GATE_STATE') or os.path.expanduser('~/.cache/claude-toolkit/mail-send-gate')
RULE = '~/.claude/rules/correo-solo-lectura.md'

REASON = ('mail-send-gate: agents do not send or change mail; {what}. Write the text in the chat or in a file and '
          'the developer sends it. Reading mail is never blocked.{extra} Rule: ' + RULE)
DRAFTS_OFF = ' Drafts are off in this machine\'s config (`drafts` in the config piece mail-send-gate).'

# Cheap prefilter: a Bash command with none of these words cannot send (extra_commands are checked separately).
PREFILTER = re.compile(r'mail|nail|msmtp|mutt|swaks|smtp', re.I)  # send-email, ssmtp, neomutt contain these

SEPARATORS = {';', '&&', '||', '|', '|&', '&', '\n', '(', ')', ';;', ';&'}
REDIRECTS = {'<', '>', '>>', '<<', '<<<', '>&', '<&', '&>', '&>>', '<>', '>|'}
QUERY_WORDS = {'which', 'type', 'man', 'whatis', 'apropos', 'whereis', 'info', 'help'}
SHELLS = {'sh', 'bash', 'zsh', 'dash'}
# Reserved words that can stand before a command in a compound command (`for …; do sendmail`, `if …; then …`).
KEYWORDS = {'do', 'then', 'else', 'elif', 'if', 'while', 'until', '{', '!'}
INTERPRETER = re.compile(r'^(python[0-9.]*|perl[0-9.]*|ruby[0-9.]*|node|nodejs|php[0-9.]*)$')
# wrapper -> options that take a value (as a separate word)
WRAPPERS = {
    'sudo': {'-u', '-g', '-C', '-D', '-h', '-p', '-r', '-t', '-U', '-T', '--user', '--group', '--chdir', '--host',
             '--prompt', '--role', '--type', '--other-user', '--close-from', '--command-timeout'},
    'env': {'-u', '-C', '-S', '--unset', '--chdir', '--split-string'},
    'xargs': {'-I', '-n', '-P', '-L', '-d', '-E', '-s', '-a', '--max-args', '--max-procs', '--max-lines',
              '--delimiter', '--eof', '--max-chars', '--arg-file', '--replace'},
    'timeout': {'-s', '-k', '--signal', '--kill-after'},
    'nice': {'-n', '--adjustment'},
    'ionice': {'-c', '-n', '-p', '-P', '-u', '--class', '--classdata', '--pid', '--pgid', '--uid'},
    'stdbuf': {'-i', '-o', '-e', '--input', '--output', '--error'},
    'nohup': set(),
    'exec': {'-a'},
    'time': {'-f', '-o', '--format', '--output'},
    'setsid': set(),
    'command': set(),
    'doas': {'-u', '-C'},
}
# Other programs that send like the listed ones (same family): sendmail-compatible, mailx-compatible, mutt, msmtp.
SENDMAIL_LIKE = {'sendmail', 'ssmtp', 'esmtp'}
MAILX_LIKE = {'mail', 'mailx', 'nail', 's-nail', 'bsd-mailx', 'heirloom-mailx', 'mail.mailutils'}
MUTT_LIKE = {'mutt', 'neomutt'}
MSMTP_LIKE = {'msmtp', 'msmtpq'}
# curl options that send the connection somewhere other than the URL's host.
CURL_REROUTE = ('--connect-to', '--resolve', '-x', '--proxy', '--preproxy', '--socks4', '--socks4a', '--socks5',
                '--socks5-hostname')
# Tools other than Bash whose `command` runs in a shell: Claude Code's Monitor and a terminal connector.
SHELL_TOOLS = {'Bash', 'Monitor'}
SHELL_MCP_TOOL = re.compile(r'^run_in_terminal$')
MARKERS = re.compile(r'smtplib|Net::SMTP|net/smtp|nodemailer|PHPMailer', re.I)
PHP_MAIL = re.compile(r'\bmail\s*\(')
STR = r'''(?:'([^'\\]*)'|"([^"\\]*)")'''
# Where an SMTP connection names its host: a call (first argument or host=) or a `host:` / `Host =` setting.
HOST_CALLS = re.compile(r'\b(?:SMTP|SMTP_SSL|LMTP)\s*\(|\.connect\s*\(|Net::SMTP(?:::SSL|S)?\s*->\s*new\s*\('
                        r'|Net::SMTP\s*\.\s*(?:start|new)\s*\(')
HOST_SETTING = re.compile(r'(?:\bhost\b|\bHost\b)\s*(?::|=>?)\s*')
# A literal counts only when it is the whole value: `'localhost' + '.evil.example'` is not `localhost`.
FIRST_ARG = re.compile(r'\s*(?:host\s*=\s*)?' + STR + r'(?=\s*[,)])')
HOST_KWARG = re.compile(r'\bhost\s*=\s*' + STR + r'(?=\s*[,)])')
SETTING_VALUE = re.compile(STR + r'(?=\s*(?:[,;})\n]|$))')
STDIN_FILES = {'-', '/dev/stdin', '/dev/fd/0', '/proc/self/fd/0'}
HEREDOC = re.compile(r'<<(?!<)-?\s*([\'"]?)([A-Za-z_][A-Za-z0-9_]*)\1')


# ---------------------------------------------------------------- logs

def _append(name, text):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, name), 'a') as fh:
            fh.write(text)
    except OSError:
        pass


def log_error(text=None):
    _append('errors.log', '--- %s\n%s\n' % (time.strftime('%Y-%m-%dT%H:%M:%S'), text or traceback.format_exc()))


def log_decision(sid, tool, decision, category):
    _append('decisions.log', '\t'.join((time.strftime('%Y-%m-%dT%H:%M:%S'), sid, tool, decision, category)) + '\n')


def deny(what, extra=''):
    json.dump({'hookSpecificOutput': {
        'hookEventName': 'PreToolUse',
        'permissionDecision': 'deny',
        'permissionDecisionReason': REASON.format(what=what, extra=extra),
    }}, sys.stdout)


def compiled(patterns):
    out = []
    for pattern in patterns:
        try:
            out.append(re.compile(pattern, re.I))
        except re.error as exc:
            log_error('mail-send-gate: pattern %r skipped: %s' % (pattern, exc))
    return out


def any_match(patterns, text):
    return any(p.search(text) for p in patterns)


# ---------------------------------------------------------------- local host

def host_of(value):
    """The host part of `host`, `host:port`, `[v6]:port` or a bare IPv6 literal, lowercased."""
    value = (value or '').strip().lower()
    if value.startswith('['):
        value = value[1:].split(']', 1)[0]
    elif value.count(':') == 1:
        value = value.split(':', 1)[0]
    return value.rstrip('.')


def is_local(host):
    host = host_of(host)
    return bool(host) and (host in ('localhost', '127.0.0.1', '::1')
                           or host.endswith('.localhost') or host.endswith('.test'))


def url_host(url):
    try:
        return urlsplit(url).hostname or ''
    except ValueError:
        return ''


# ---------------------------------------------------------------- shell parsing

def cut_heredocs(text):
    """Remove heredoc bodies from TEXT; return (text without bodies, [bodies in order])."""
    lines = text.split('\n')
    out, bodies, i = [], [], 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        i += 1
        for match in HEREDOC.finditer(line):
            delim = match.group(2)
            body = []
            while i < len(lines) and lines[i].strip() != delim:
                body.append(lines[i])
                i += 1
            i += 1  # the delimiter line
            bodies.append('\n'.join(body))
    return '\n'.join(out), bodies


def substitutions(text):
    """The inside of every $(…) and `…` that is not inside single quotes."""
    found, i, quote, n = [], 0, None, len(text)
    while i < n:
        ch = text[i]
        if quote == "'":
            if ch == "'":
                quote = None
        elif ch == '\\':
            i += 1
        elif ch == "'" and quote is None:
            quote = "'"
        elif ch == '"':
            quote = None if quote == '"' else '"'
        elif ch == '`':
            end = text.find('`', i + 1)
            if end < 0:
                break
            found.append(text[i + 1:end])
            i = end
        elif ch == '$' and i + 1 < n and text[i + 1] == '(':
            depth, j = 1, i + 2
            while j < n and depth:
                if text[j] == '(':
                    depth += 1
                elif text[j] == ')':
                    depth -= 1
                j += 1
            found.append(text[i + 2:j - 1])
            i = j - 1
        i += 1
    return found


def tokenize(text):
    try:
        lex = shlex.shlex(text, posix=True, punctuation_chars='();<>|&\n')
        lex.whitespace = ' \t\r'
        lex.whitespace_split = True
        lex.commenters = ''
        return list(lex)
    except ValueError:
        return re.findall(r'\|\||&&|;|\||&|\n|[()<>]|[^\s;|&()<>]+', text)


class Simple:
    """One simple command: its words (redirections removed), its stdin text, its pipeline predecessors' text."""

    def __init__(self):
        self.words, self.stdin, self.upstream, self.upstream_args = [], [], [], []


def simple_commands(text, bodies):
    bodies = list(bodies)
    tokens = tokenize(text)
    commands, current, pipeline, pipe_args = [], Simple(), [], []
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok in SEPARATORS:
            if current.words:
                commands.append(current)
            if tok in ('|', '|&') and current.words:
                pipeline = pipeline + [' '.join(current.words + current.stdin)]
                pipe_args = pipe_args + [' '.join(current.words[1:])] + current.stdin
            else:
                pipeline, pipe_args = [], []
            current = Simple()
            current.upstream = list(pipeline)
            current.upstream_args = list(pipe_args)
            i += 1
            continue
        if tok in REDIRECTS:
            target = tokens[i + 1] if i + 1 < len(tokens) else ''
            if tok == '<<':
                if bodies:
                    current.stdin.append(bodies.pop(0))
            elif tok == '<<<':
                current.stdin.append(target)
            i += 2
            continue
        current.words.append(tok)
        i += 1
    if current.words:
        commands.append(current)
    return commands


def cluster_takes_value(opt, takes):
    """True when OPT is a short-option cluster (`-iu`) whose last letter takes the next word as its value."""
    if opt.startswith('--') or len(opt) < 3:
        return False
    for idx, letter in enumerate(opt[1:]):
        if '-' + letter in takes:
            return idx == len(opt) - 2
    return False


def strip_prefixes(words):
    """Skip assignments and wrappers. Returns the words from the command word on, or [] for a query."""
    i = 0
    while i < len(words):
        word = words[i]
        if word in KEYWORDS or re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', word):
            i += 1
            continue
        name = os.path.basename(word)
        if name in QUERY_WORDS:
            return []
        if name not in WRAPPERS:
            return words[i:]
        takes = WRAPPERS[name]
        i += 1
        if name == 'command':
            while i < len(words) and words[i].startswith('-'):
                if words[i] in ('-v', '-V'):
                    return []
                i += 1
            continue
        while i < len(words):
            opt = words[i]
            if opt == '--':
                i += 1
                break
            if name == 'env' and re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', opt):
                i += 1
                continue
            if not opt.startswith('-') or opt == '-':
                break
            i += 2 if opt in takes or cluster_takes_value(opt, takes) else 1
        if name == 'timeout' and i < len(words):
            i += 1  # the duration
    return []


# ---------------------------------------------------------------- Bash rules

def option_value(args, names, prefixes=()):
    """Values of the options NAMES (`--x V`) and PREFIXES (`--x=V`) in ARGS."""
    values = []
    for i, arg in enumerate(args):
        if arg in names and i + 1 < len(args):
            values.append(args[i + 1])
        for prefix in prefixes:
            if arg.startswith(prefix) and len(arg) > len(prefix):
                values.append(arg[len(prefix):])
    return values


MUTT_VALUE_OPTS = {'-f', '-F', '-e', '-s', '-a', '-b', '-c', '-H', '-i', '-m', '-Q', '-d'}


def mutt_sends(args):
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ('-s', '-a', '-H') or arg.startswith(('-s', '-H')) and len(arg) > 2:
            return True
        if arg == '--':
            return i + 1 < len(args)
        if arg.startswith('-'):
            i += 2 if arg in MUTT_VALUE_OPTS else 1
            continue
        return True  # a recipient
    return False


def interpreter_code(name, args, cmd):
    """The inline code an interpreter runs (code option, module options, stdin it reads), or '' for a script or
    module run with no inline code."""
    base = re.sub(r'[0-9.]+$', '', name)
    code_opts = {'python': {'-c'}, 'perl': {'-e', '-E'}, 'ruby': {'-e'}, 'node': {'-e', '--eval', '-p', '--print'},
                 'nodejs': {'-e', '--eval', '-p', '--print'}, 'php': {'-r'}}.get(base, set())
    code, modules, has_code, runs_file = [], [], False, False
    i = 0
    while i < len(args):
        arg = args[i]
        if base == 'python':
            cluster = re.match(r'^-[bBdEhiIOqsSuvxRP]*([cm])(.*)$', arg, re.S)
            if cluster and cluster.group(1) == 'm':
                runs_file = True
                break
            if cluster:
                has_code = True
                if cluster.group(2):
                    code.append(cluster.group(2))
                elif i + 1 < len(args):
                    code.append(args[i + 1])
                break  # what follows the code is the program's own argv
        elif base == 'perl' and arg[:2] not in ('-M', '-m') and re.match(r'^-[a-zA-Z0-9]*[eE]$', arg):
            arg = '-e'
        elif base == 'ruby' and not arg.startswith('-r') and re.match(r'^-[a-zA-Z]*e$', arg):
            arg = '-e'
        if arg in code_opts:
            has_code = True
            if i + 1 < len(args):
                code.append(args[i + 1])
            if base == 'python':
                break  # what follows -c is the program's own argv
            i += 2
            continue
        if base == 'python':
            if arg.startswith('-c') and len(arg) > 2:
                code.append(arg[2:])
                has_code = True
                break
            if arg.startswith('-m'):
                runs_file = True
                break
            if arg in ('-W', '-X'):
                i += 2
                continue
        elif base == 'perl' and arg[:2] in ('-M', '-m') and len(arg) > 2:
            modules.append(arg)
        elif base == 'ruby' and arg.startswith('-r'):
            if len(arg) > 2:
                modules.append(arg)
            elif i + 1 < len(args):
                modules.append(args[i + 1])
                i += 1
        elif base in ('node', 'nodejs') and arg in ('-r', '--require'):
            if i + 1 < len(args):
                modules.append(args[i + 1])
                i += 1
        if arg in STDIN_FILES:
            break  # the program comes from stdin
        if not arg.startswith('-'):
            runs_file = True
            break
        i += 1
    if has_code or runs_file:
        return '\n'.join(code + modules)
    return '\n'.join(modules + cmd.stdin + cmd.upstream)


def _literal(match):
    return match.group(1) if match.group(1) is not None else match.group(2)


def host_literals(code):
    """The host of every SMTP connection in CODE, None where it is not a plain string literal. A call with no
    argument (`SMTP()`, `.connect()`) names no remote host and is skipped."""
    hosts = []
    for call in HOST_CALLS.finditer(code):
        rest = code[call.end():]
        if re.match(r'\s*\)', rest):
            continue
        match = FIRST_ARG.match(rest)
        if not match:
            match = HOST_KWARG.search(rest.split(')', 1)[0] + ')')
        hosts.append(_literal(match) if match else None)
    for setting in HOST_SETTING.finditer(code):
        match = SETTING_VALUE.match(code, setting.end())
        hosts.append(_literal(match) if match else None)
    return hosts


def check_simple(cmd, depth):
    """A category string when CMD sends mail, else None."""
    words = strip_prefixes(cmd.words)
    if not words:
        return None
    name = os.path.basename(words[0])
    args = words[1:]
    if name in SHELLS:
        return check_shell(cmd, args, depth)
    if name == 'eval':
        return check_text(' '.join(args), depth + 1)
    if name == 'su':
        for i, arg in enumerate(args):
            if arg in ('-c', '--command') and i + 1 < len(args):
                return check_text(args[i + 1], depth + 1)
            if arg.startswith('--command='):
                return check_text(arg[len('--command='):], depth + 1)
        return None
    if name == 'find':
        for i, arg in enumerate(args):
            if arg in ('-exec', '-execdir', '-ok', '-okdir'):
                inner = []
                for word in args[i + 1:]:
                    if word in (';', '+'):
                        break
                    inner.append(word)
                inner_cmd = Simple()
                inner_cmd.words = inner
                found = check_simple(inner_cmd, depth + 1)
                if found:
                    return found
        return None
    if name == 'git':
        return check_git(args)
    if name in SENDMAIL_LIKE:
        return 'bash-sendmail'
    if name in MAILX_LIKE:
        return 'bash-mailx' if name != 'mail' else 'bash-mail'
    if name in MUTT_LIKE:
        return 'bash-mutt' if mutt_sends(args) else None
    if name in MSMTP_LIKE:
        hosts = option_value(args, {'--host'}, ('--host=',))
        return None if hosts and all(is_local(h) for h in hosts) else 'bash-msmtp'
    if name == 'swaks':
        hosts = option_value(args, {'--server', '-s', '-server'}, ('--server=',))
        return None if hosts and all(is_local(h) for h in hosts) else 'bash-swaks'
    if name == 'curl':
        urls = []
        for value in args + option_value(args, set(), ('--url=',)):
            if re.match(r'^smtps?://', value, re.I):
                urls.append(value)
        if urls:
            rerouted = any(a in CURL_REROUTE or a.startswith(tuple(o + '=' for o in CURL_REROUTE if o.startswith('--')))
                           or (a.startswith('-x') and len(a) > 2) for a in args)
            return None if not rerouted and all(is_local(url_host(u)) for u in urls) else 'bash-curl'
        if any(a in ('--mail-rcpt', '--mail-from') or a.startswith(('--mail-rcpt=', '--mail-from=')) for a in args):
            return 'bash-curl'
        return None
    if INTERPRETER.match(name):
        code = interpreter_code(name, args, cmd)
        if not code:
            return None
        if not (MARKERS.search(code) or (name.startswith('php') and PHP_MAIL.search(code))):
            return None
        if name.startswith('php') and PHP_MAIL.search(code):
            return 'bash-inline'
        hosts = host_literals(code)
        return None if hosts and all(h is not None and is_local(h) for h in hosts) else 'bash-inline'
    return None


SHELL_VALUE_OPTS = {'-o', '+o', '-O', '+O', '--rcfile', '--init-file'}


def check_shell(cmd, args, depth):
    """`sh|bash|zsh|dash`: scan the `-c` text, or, when it runs no script file, the commands it reads on stdin."""
    i = 0
    while i < len(args):
        arg = args[i]
        if re.match(r'^-[a-zA-Z]*c[a-zA-Z]*$', arg):
            return check_text(args[i + 1], depth + 1) if i + 1 < len(args) else None
        if arg in SHELL_VALUE_OPTS:
            i += 2
            continue
        if arg == '--':
            if i + 1 < len(args):
                return None  # a script file
            break
        if arg.startswith(('-', '+')) and arg not in STDIN_FILES:
            i += 1
            continue
        if arg not in STDIN_FILES:
            return None  # a script file (known limit)
        break
    for text in cmd.stdin + cmd.upstream_args:
        found = check_text(text, depth + 1)
        if found:
            return found
    return None


GIT_VALUE_OPTS = {'-C', '-c', '--git-dir', '--work-tree', '--namespace', '--exec-path', '--config-env'}


def check_git(args):
    """`git send-email` sends unless `--smtp-server` names only the local test mailer."""
    i = 0
    while i < len(args) and args[i].startswith('-'):
        i += 2 if args[i] in GIT_VALUE_OPTS else 1
    if i >= len(args) or args[i] != 'send-email':
        return None
    rest = args[i + 1:]
    servers = option_value(rest, {'--smtp-server'}, ('--smtp-server=',))
    return None if servers and all(is_local(s) for s in servers) else 'bash-git-send-email'


def check_text(text, depth=0):
    if depth > 5 or not text:
        return None
    text, bodies = cut_heredocs(text)
    for inner in substitutions(text):
        found = check_text(inner, depth + 1)
        if found:
            return found
    for cmd in simple_commands(text, bodies):
        found = check_simple(cmd, depth)
        if found:
            return found
    return None


def exempt(cwd, prefixes):
    if not cwd or not prefixes:
        return False
    here = os.path.realpath(os.path.expanduser(cwd))
    for prefix in prefixes:
        base = os.path.realpath(os.path.expanduser(prefix)).rstrip('/')
        if base and (here == base or here.startswith(base + '/')):
            return True
    return False


# ---------------------------------------------------------------- decision

WHAT = {
    'bash-sendmail': 'this command runs sendmail', 'bash-mail': 'this command runs mail',
    'bash-mailx': 'this command runs mailx', 'bash-mutt': 'this command sends with mutt',
    'bash-msmtp': 'this command sends with msmtp to a server that is not the local test mailer',
    'bash-swaks': 'this command sends with swaks to a server that is not the local test mailer',
    'bash-curl': 'this command sends over SMTP with curl to a server that is not the local test mailer',
    'bash-inline': 'this inline script uses an SMTP library without naming only the local test mailer',
    'bash-git-send-email': 'this command sends with git send-email to a server that is not the local test mailer',
    'bash-extra': 'this command is one of the send commands named in this machine\'s config',
}


def decide_connector(sid, tool, cfg):
    rest = tool[len('mcp__'):]
    if '__' not in rest:
        return
    server, name = rest.rsplit('__', 1)
    if any_match(compiled(cfg['ignore_servers']), server):
        return
    if any_match(compiled(cfg['read_tools']), name):
        return
    is_draft = any_match(compiled(cfg['draft_tools']), name)
    if cfg['drafts'] and is_draft:
        return
    if any_match(compiled(cfg['send_tools']), name):
        log_decision(sid, tool, 'deny', 'deny-connector')
        deny('the connector tool %s sends or changes mail' % name, DRAFTS_OFF if is_draft else '')


def decide_bash(sid, payload, cfg):
    command = (payload.get('tool_input') or {}).get('command')
    if not isinstance(command, str) or not command.strip():
        return
    extra = compiled(cfg['extra_commands'])
    if not PREFILTER.search(command) and not extra:
        return
    category = None
    if any_match(extra, command):
        category = 'bash-extra'
    elif PREFILTER.search(command):
        category = check_text(command)
    if not category:
        return
    if exempt(payload.get('cwd'), cfg['exempt_paths']):
        log_decision(sid, payload.get('tool_name'), 'allow', 'allow-exempt')
        return
    log_decision(sid, payload.get('tool_name'), 'deny', 'deny-' + category)
    deny(WHAT[category])


def decide(payload):
    tool = payload.get('tool_name')
    if not isinstance(tool, str) or not (tool in SHELL_TOOLS or tool.startswith('mcp__')):
        return
    cfg = _load_config('mail-send-gate', DEFAULTS)
    sid = payload.get('session_id') if isinstance(payload.get('session_id'), str) else 'unknown'
    if tool in SHELL_TOOLS or SHELL_MCP_TOOL.search(tool.rsplit('__', 1)[-1]):
        decide_bash(sid, payload, cfg)
    else:
        decide_connector(sid, tool, cfg)


def main():
    try:
        payload = json.load(sys.stdin)
        if isinstance(payload, dict):
            decide(payload)
    except Exception:
        log_error()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
