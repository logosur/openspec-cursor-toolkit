# 0 = wait as long as needed. A limit would make a queued job die and lose its place.
DEFAULT_MAX_WAIT = 0
# Cloud tests (optional: cloud-tests comes with this module, and a project opts in with its .claude/cloud-tests.json):
# a suite that runs in the cloud is not run here too. `cloud-tests local-guard`
# says whether this same suite on this same code is already running (or already green) in the cloud; if so, the job is
# not started (exit 76). `cloud-tests` stops a redundant local job that was already running or queued and leaves a note
# in cloud-stopped/<wrapper pid>.txt, which the wrapper prints before exiting with 76.
CLOUD_TESTS_BIN = os.environ.get('CLOUD_TESTS_BIN', os.path.expanduser('~/.claude/scripts/cloud-tests'))
CLOUD_EXIT = 76
CLOUD_STOPPED_DIR = 'cloud-stopped'
EX_TEMPFAIL = 75
DETACHED_DIR = os.path.expanduser('~/.local/state/heavy-job/detached')  # $HEAVY_JOB_DETACHED_DIR overrides it
DETACHED_UNIT_PREFIX = 'heavy-job-'
DETACHED_ID_RE = re.compile(r'^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$')
DETACHED_DIED = 70          # `wait`: the runner died without leaving an exit code
WAIT_TIMED_OUT = 124        # `wait --timeout`: the job is still queued or running
DETACHED_KEEP_DAYS = 7      # finished detached jobs older than this are pruned at the next launch
ML_WEIGHT = 2
DEFAULT_MIN_AVAIL_GIB = 2.5
DEFAULT_SETTLE = 45.0
# A process this big that maps one of these libraries is a resident model (a whisper job, a model daemon). It
# counts as ONE unwrapped `ml` job of weight 1, so a daemon that stays loaded can never starve everything.
ML_RSS_KIB = 1536 * 1024
ML_LIB_MARKERS = (b'libtorch', b'/torch/lib', b'ctranslate2', b'onnxruntime', b'tensorflow')

LIGHT_DIR = 'light'                     # subdirectory of the state dir: the light pool's own slots and queue
LIGHT_ENV = 'HEAVY_JOB_LIGHT_SLOT'      # NOT HEAVY_JOB_SLOT: projects read that one as "a heavy slot is held"
DEFAULT_LIGHT_SLOTS = 3
